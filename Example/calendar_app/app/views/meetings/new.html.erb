<%# app/views/meetings/new.html.erb %>

<div class="py-10 max-w-2xl">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Send a Meeting Request</h1>
  <p class="mt-2 text-slate-600">
    Persists a stable <code class="px-1 py-0.5 rounded bg-slate-100 text-sm">uid</code>/<code class="px-1 py-0.5 rounded bg-slate-100 text-sm">sequence</code>
    on a <code class="px-1 py-0.5 rounded bg-slate-100 text-sm">Meeting</code> record, then sends it as an RFC 5545
    <code class="px-1 py-0.5 rounded bg-slate-100 text-sm">METHOD:REQUEST</code>. See
    <%= link_to "meetings_path", meetings_path, class: "underline" %> for the reschedule/cancel actions.
  </p>

  <%= form_with model: @meeting, local: true, class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :title, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :start_time, class: "block text-sm font-medium text-slate-700" %>
        <%= f.datetime_field :start_time, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :end_time, class: "block text-sm font-medium text-slate-700" %>
        <%= f.datetime_field :end_time, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :timezone, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :timezone, value: f.object.timezone || "America/Los_Angeles", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :location, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :location, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :video_url, "Video call URL", class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :video_url, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :organizer_name, class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :organizer_name, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :organizer_email, class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :organizer_email, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700">Attendee emails (comma-separated)</label>
      <%= text_field_tag "meeting[attendee_emails]", nil, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
    </div>

    <%= f.submit "Send invite", class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2.5 shadow-sm transition-colors cursor-pointer" %>
  <% end %>
</div>
