<%# app/views/calendars/index.html.erb %>

<div class="py-10">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Calendar Invite Examples</h1>
  <p class="mt-2 text-slate-600 max-w-2xl">
    Live demos of every <code class="px-1 py-0.5 rounded bg-slate-100 text-sm">cal_invite</code> provider:
    add-to-calendar links for Google, Outlook, Office 365 and Yahoo, plus downloadable
    <code class="px-1 py-0.5 rounded bg-slate-100 text-sm">.ics</code> files for Apple Calendar and generic clients.
  </p>

  <div class="mt-6">
    <%= button_to send_test_email_calendars_path,
        method: :post,
        class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2.5 shadow-sm transition-colors" do %>
      <%= icon(:mail, css_class: "size-4") %>
      Send Test Email Invitation
    <% end %>
  </div>
</div>

<%= render "event_section",
    event: @simple_event,
    event_type: "simple",
    title: "Simple Meeting",
    description: "A basic event at Apple's historical headquarters with minimal attributes." %>

<%= render "event_section",
    event: @video_event,
    event_type: "video",
    title: "Video Meeting (no physical location)",
    description: "Location is left blank; only a virtual meeting url is set. Providers link straight to the video call." %>

<%= render "event_section",
    event: @all_day_event,
    event_type: "all_day",
    title: "All-Day Event",
    description: "A full-day event with no specific start/end time." %>

<%= render "event_section",
    event: @rsvp_event,
    event_type: "rsvp",
    method: :request,
    title: "RSVP Meeting Request",
    description: "Built with organizer: and generated with method: :request, so the downloaded .ics is a real RFC 5545 meeting request — mail clients show Accept / Decline actions instead of a plain attachment." %>

<%= render "event_section",
    event: @complete_event,
    event_type: "complete",
    title: "Full Feature Event",
    description: "A comprehensive event showcasing location, url, attendees and notes together." %>
