<%# Renders one event example: heading, meta row, and a provider grid. %>
<%#
  Locals:
  event        - CalInvite::Event
  event_type   - String param used by download_ics (e.g. "simple", "video", "rsvp")
  title        - String heading
  description  - String blurb
  method       - :publish (default) or :request, forwarded to ics/ical downloads
%>
<% method ||= :publish %>
<section class="mb-10 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-start justify-between gap-4 flex-wrap mb-1">
    <h2 class="text-lg font-semibold text-slate-900"><%= title %></h2>
    <% if method == :request %>
      <span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-medium px-2.5 py-1">
        <%= icon(:mail, css_class: "size-3.5") %>
        RSVP-capable (METHOD:REQUEST)
      </span>
    <% end %>
  </div>
  <p class="text-sm text-slate-600 mb-4"><%= description %></p>

  <dl class="flex flex-wrap gap-x-6 gap-y-1.5 text-sm text-slate-500 mb-5">
    <div class="flex items-center gap-1.5">
      <%= icon(:clock, css_class: "size-4 text-slate-400") %>
      <%= event.all_day ? event.start_time.in_time_zone(event.timezone).strftime("%B %d, %Y") : "#{event.start_time.in_time_zone(event.timezone).strftime('%B %d, %Y %I:%M %p')} #{event.timezone}" %>
    </div>
    <% if event.location.present? %>
      <div class="flex items-center gap-1.5">
        <%= icon(:pin, css_class: "size-4 text-slate-400") %>
        <%= event.location %>
      </div>
    <% end %>
    <% if event.url.present? %>
      <div class="flex items-center gap-1.5">
        <%= icon(:video, css_class: "size-4 text-slate-400") %>
        Video link included
      </div>
    <% end %>
    <% if event.attendees.present? %>
      <div class="flex items-center gap-1.5">
        <%= icon(:users, css_class: "size-4 text-slate-400") %>
        <%= pluralize(event.attendees.size, "attendee") %>
      </div>
    <% end %>
  </dl>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <% @providers.each do |provider| %>
      <% is_file = [:ics, :ical].include?(provider) %>
      <div class="flex items-center justify-between gap-3 rounded-lg border border-slate-200 px-4 py-3 hover:border-indigo-300 hover:bg-indigo-50/40 transition-colors">
        <span class="text-sm font-medium text-slate-700"><%= provider.to_s.sub('ics', 'ICS File').sub('ical', 'Apple Calendar').titleize %></span>
        <% if is_file %>
          <%= link_to download_ics_calendars_path(event_type: event_type, provider: provider, method: method),
              class: "inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 hover:text-indigo-800" do %>
            <%= icon(:download, css_class: "size-4") %>
            Download
          <% end %>
        <% else %>
          <%= link_to event.generate_calendar_url(provider),
              class: "inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 hover:text-indigo-800",
              target: "_blank", rel: "noopener" do %>
            <%= icon(:external_link, css_class: "size-4") %>
            Add
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
